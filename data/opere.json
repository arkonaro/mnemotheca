[
{
"id": "41b020c80f528194b2bdf727773b9dce",
"titolo": "DISSIPATE No. 8 OF NINE NEVADA DEPRESSIONS",
"autore": "Michael Heizer",
"anno": "1968",
"disciplina": "Arte",
"data": "2017-01-03",
"img": [
"17846465176190040"
],
"n": 1,
"testo": "Five shallow trenches lined with wood, cut into the dry lakebed of Black Rock Desert in Nevada and placed as if matches had been dropped on the ground. Part of a series of nine works across the Nevada desert, made to be eroded and lost. Land art at its beginning: sculpture made by taking material away."
},
{
"id": "41b020c80f528110ab4de4be027d17e7",
"titolo": "Le Château des Pyrénées",
"autore": "René Magritte",
"anno": "1959",
"disciplina": "Arte",
"data": "2017-01-03",
"img": [
"17846452384183569"
],
"n": 2,
"testo": "A huge boulder hangs above a stormy sea, with a small castle growing out of its top. Magritte paints the impossible with the calm precision of a postcard, so that gravity seems to be the thing that is wrong. The painting is in the Israel Museum, Jerusalem."
},
{
"id": "41b020c80f528159bd29d44330043cc3",
"titolo": "Monumento Continuo",
"autore": "Superstudio",
"anno": "1969",
"disciplina": "Architettura",
"data": "2017-01-03",
"img": [
"17868658693048136"
],
"n": 3,
"testo": "A single gridded structure that wraps the whole planet, crossing deserts, cities and seas without changing. The Florentine group drew it in collages as a critique of architecture's will to order everything. One of the founding images of Radical Architecture."
},
{
"id": "41b020c80f5281abb253febb7d4c767e",
"titolo": "Strike: to Roberta and Rudy",
"autore": "Richard Serra",
"anno": "1971",
"disciplina": "Arte",
"data": "2017-01-04",
"img": [
"17848081630141345"
],
"n": 4,
"testo": "A single plate of hot-rolled steel, eight by twenty-four feet, wedged into the corner of a room and held there only by the two walls. It cuts the space in two, and as you walk around it the plate turns from surface to edge and back. Now at the Guggenheim, New York."
},
{
"id": "41b020c80f52810f888fcaa6e003f4d6",
"titolo": "Roden Crater",
"autore": "James Turrell",
"anno": "1972",
"disciplina": "Arte",
"data": "2017-01-04",
"img": [
"17848237318135282"
],
"n": 5,
"testo": "An extinct volcanic cone in the Painted Desert of Arizona, bought by Turrell in 1979 and reshaped from inside into an observatory for the naked eye. Tunnels and chambers frame the sky, the sun and the moon. Still in progress after more than four decades."
},
{
"id": "41b020c80f528197842cc4c143d6ddd4",
"titolo": "The Elemental House, the California Pool",
"autore": "Charles Jenks and Buzz Yudell",
"anno": "1982",
"disciplina": "Architettura",
"data": "2017-01-05",
"img": [
"17846682955159000"
],
"n": 6,
"testo": "A 1950s ranch house reworked around the four elements, earth, water, air and fire. Its pool is shaped like the State of California. Postmodern symbolism, played with a straight face."
},
{
"id": "41b020c80f52818a82ffca621a4a5dff",
"titolo": "Modular Cube",
"autore": "Sol Lewitt",
"anno": "1965",
"disciplina": "Arte",
"data": "2017-01-06",
"img": [
"17846652373159788"
],
"n": 7,
"testo": "An open lattice of identical square cells, the same in every direction. LeWitt chose the cube because it is the least expressive form there is, and so it lets the system be the subject. The idea is the machine that makes the art."
},
{
"id": "41b020c80f5281b8b4befdbfa6a38214",
"titolo": "Architecture Oblique",
"autore": "Claude Parent",
"anno": "1973",
"disciplina": "Architettura",
"data": "2017-01-06",
"img": [
"17871406315006170"
],
"n": 8,
"testo": "With Paul Virilio, Parent proposed living on inclined planes instead of flat floors: walking would become climbing, and the body would feel every move. Built examples are few, the church of Sainte-Bernadette in Nevers (1966) among them, but the drawings remain."
},
{
"id": "41b020c80f5281c0a2ccc646943ab3ed",
"titolo": "Amsterdam Orphanage",
"autore": "Aldo Van Eyck",
"anno": "1960",
"disciplina": "Architettura",
"data": "2017-01-06",
"img": [
"17860606639108425"
],
"n": 9,
"testo": "A small city for children: repeated domed units grouped in clusters, with interior streets and courtyards between them. Van Eyck called it a house like a small city and a city like a large house. A founding work of Dutch Structuralism."
},
{
"id": "41b020c80f5281abb7eee7eecf4a6da9",
"titolo": "White on Black",
"autore": "Wassily Kandinsky",
"anno": "1930",
"disciplina": "Arte",
"data": "2017-01-07",
"img": [
"17860156492073263"
],
"n": 10,
"testo": "Painted in his last years at the Bauhaus in Dessau: thin, floating geometric shapes on a black ground. For Kandinsky black was a silence without future, against which every color sounds sharper."
},
{
"id": "41b020c80f528197a3cdc5169ebb2d78",
"titolo": "No-Stop City, Interior Landscape",
"autore": "Archizoom",
"anno": "1969",
"disciplina": "Architettura",
"data": "2017-01-08",
"img": [
"17857274713083999"
],
"n": 11,
"testo": "An endless, homogeneous interior, lit and air-conditioned like a supermarket, where furniture and tents replace buildings. Archizoom drew it with a typewriter, as a grid of characters, to show the city as pure quantity. A radical critique of the modern metropolis."
},
{
"id": "41b020c80f5281058789c1db3c70594b",
"titolo": "The Incomplete Truth",
"autore": "Damien Hirst",
"anno": "2006",
"disciplina": "Arte",
"data": "2017-01-08",
"img": [
"17869384444013591"
],
"n": 12,
"testo": "A white dove with spread wings, suspended in formaldehyde inside a glass and steel case. The sign of the Holy Spirit and of peace becomes a specimen."
},
{
"id": "41b020c80f5281a89843d0fb13ce12c9",
"titolo": "Concetto Spaziale, Attese",
"autore": "Lucio Fontana",
"anno": "1963",
"disciplina": "Arte",
"data": "2017-01-08",
"img": [
"17860326481078793"
],
"n": 13,
"testo": "A monochrome canvas opened by clean cuts with a blade. Fontana's slashes are not destruction but an opening onto the space behind the painting. 'Attese' means waitings."
},
{
"id": "41b020c80f5281829890dbabe9980e18",
"titolo": "Teatro del Mondo",
"autore": "Aldo Rossi",
"anno": "1980",
"disciplina": "Architettura",
"data": "2017-01-10",
"img": [
"17868991513010853"
],
"n": 14,
"testo": "A floating wooden theatre built for the Venice Biennale, towed across the lagoon on a barge and moored in front of the Punta della Dogana. It belonged to the city for one season, then it was dismantled. Rossi's most poetic building, made to disappear."
},
{
"id": "41b020c80f528177b6cfe26e348c0d0d",
"titolo": "Still Life",
"autore": "Tom Wesselmann",
"anno": "1962",
"disciplina": "Arte",
"data": "2017-01-12",
"img": [
"17883630637053342"
],
"n": 15,
"testo": "From the series of Still Lifes begun in 1962: collage and paint on board, with supermarket products and advertising images arranged like a Dutch still life. American abundance seen in the flat language of the billboard."
},
{
"id": "41b020c80f52816b8ad0c36b54152947",
"titolo": "Interior of the Barcelona Pavilion",
"autore": "Ludwig Mies Van der Rohe",
"anno": "1929",
"disciplina": "Architettura",
"data": "2017-01-12",
"img": [
"17848298599137964"
],
"n": 16,
"testo": "German pavilion for the International Exposition in Barcelona: free-standing walls of onyx and green marble, chromed cruciform columns, and a reflecting pool. Demolished in 1930 and rebuilt on the same site in 1986."
},
{
"id": "41b020c80f5281a78b58eb442374f9b9",
"titolo": "Still Life with Goldfish",
"autore": "Roy Lichtenstein",
"anno": "1972",
"disciplina": "Arte",
"data": "2017-01-15",
"img": [
"17847114436181137"
],
"n": 17,
"testo": "Lichtenstein quotes Matisse's goldfish bowl and translates it into Ben-Day dots, black outlines and flat color. Painting about painting, in the language of comic strips."
},
{
"id": "41b020c80f528151b99cc959790f273e",
"titolo": "“The Big Duck”, Long Island, New York",
"autore": "Venturi, Scott Brown",
"anno": "1970",
"disciplina": "Architettura",
"data": "2017-01-15",
"img": [
"17847180436157891"
],
"n": 18,
"testo": "A building in the shape of a duck, built by a duck farmer to sell ducks and eggs. Robert Venturi, Denise Scott Brown and Steven Izenour used it in Learning from Las Vegas (1972) as their 'duck': a building whose form is its sign, against the 'decorated shed'."
},
{
"id": "41b020c80f5281d097bae2bf94d827c9",
"titolo": "Bauhaus Experimente",
"autore": "Herbert Bayer",
"anno": "1925",
"disciplina": "Design",
"data": "2017-01-16",
"img": [
"17857621327088927"
],
"n": 19,
"testo": "Bayer studied at the Bauhaus in Weimar and in 1925 became head of the new printing and advertising workshop in Dessau. He designed the 'universal' alphabet in lower case only. Typography reduced to geometry."
},
{
"id": "41b020c80f528195921efeead1ecc049",
"titolo": "Scandiano",
"autore": "Luigi Ghirri",
"anno": "1971",
"disciplina": "Fotografia",
"data": "2017-01-17",
"img": [
"17863849702065722"
],
"n": 20,
"testo": "Ghirri was born in Scandiano, near Reggio Emilia, and began photographing in the early 1970s, while still working as a surveyor. His Emilia is made of signs, walls and empty corners, looked at with quiet attention."
},
{
"id": "41b020c80f528116a057fbc81ff022db",
"titolo": "House at Minami-Aoyama, Tokyo",
"autore": "Kunihiko Hayakawa",
"anno": "1981",
"disciplina": "Architettura",
"data": "2017-01-17",
"img": [
"17848714240139951"
],
"n": 21,
"testo": "Hayakawa built his architecture around the 'landscapes that architecture produces' in the city. His Tokyo houses read like fragments of stage set, layered planes and colors in a dense, fragmented city."
},
{
"id": "41b020c80f52813781cbf2465577559b",
"titolo": "I am a Monument",
"autore": "Venturi, Scott Brown (?)",
"anno": "1972 (?)",
"disciplina": "Architettura",
"data": "2017-01-19",
"img": [
"17870453092029768"
],
"n": 22,
"testo": "A drawing from Learning from Las Vegas: a plain shed with a huge sign that announces 'I am a monument'. The decorated shed, where the meaning is written on the building rather than built into it."
},
{
"id": "41b020c80f5281f1885fd46b51436404",
"titolo": "Le Carceri D’invenzione, Tavola VII",
"autore": "Giovanni Battista Piranesi",
"anno": "1745",
"disciplina": "Architettura",
"data": "2017-01-21",
"img": [
"17859259897112366"
],
"n": 23,
"testo": "The Drawbridge: stairs, bridges and walkways climb through a vast, impossible prison. The Carceri were first etched around 1745–50 and reworked, darker and deeper, in 1761."
},
